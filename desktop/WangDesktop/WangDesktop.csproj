<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <RootNamespace>WangDesktop</RootNamespace>
    <AssemblyName>WangDesktop</AssemblyName>
    <ApplicationIcon>Assets\wang.ico</ApplicationIcon>
    <UseWindowsForms>true</UseWindowsForms>
    <Version>1.0.0</Version>
    <Product>王将军AI工作台</Product>
    <AssemblyTitle>王将军AI工作台</AssemblyTitle>
    <Description>王将军的专属 AI 创作与自动化工作台</Description>
    <Company>王将军</Company>
    <Copyright>王将军</Copyright>
    <SatelliteResourceLanguages>zh-Hans</SatelliteResourceLanguages>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <SatelliteResourcePaths>zh-Hans</SatelliteResourcePaths>
    <DebugType>none</DebugType>
    <PublishReadyToRun>false</PublishReadyToRun>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3124.44" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\wang.ico" />
    <Content Include="Assets\wang-logo.svg">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
